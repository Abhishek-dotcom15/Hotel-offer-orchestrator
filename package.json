{
  "name": "hotel-offer-orchestrator",
  "version": "1.0.0",
  "description": "Hotel offer aggregation service using Temporal and Redis",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently -n api,worker -c blue,green \"npm run dev:api\" \"npm run dev:worker\"",
    "dev:api": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/temporal/worker.ts",
    "start": "concurrently -n api,worker \"npm run start:api\" \"npm run start:worker\"",
    "start:api": "node dist/index.js",
    "start:worker": "node dist/temporal/worker.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "hotel",
    "temporal",
    "redis",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@temporalio/activity": "^1.26.0",
    "@temporalio/client": "^1.26.0",
    "@temporalio/worker": "^1.26.0",
    "@temporalio/workflow": "^1.26.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "redis": "^6.3.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
